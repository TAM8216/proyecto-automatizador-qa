# SUT IPAS local
SUT_FRONTEND_URL=http://localhost:3000
SUT_API_URL=http://127.0.0.1:4000/api
SUT_IA_URL=http://127.0.0.1:8001

# Base exclusivamente QA. La plataforma rechaza cualquier otro nombre.
QA_DB_HOST=127.0.0.1
QA_DB_PORT=5432
QA_DB_NAME=ius_puniendi_qa
QA_DB_USER=postgres
QA_DB_PASSWORD=CAMBIAR_LOCALMENTE

# Usuarios ficticios creados por data/seed/seed_qa.py
QA_SUPERADMIN_EMAIL=qa.superadmin@ipas.test
QA_SUPERADMIN_PASSWORD=CAMBIAR_LOCALMENTE
QA_ADMIN_EMAIL=qa.admin@ipas.test
QA_ADMIN_PASSWORD=CAMBIAR_LOCALMENTE
QA_ABOGADO_EMAIL=qa.abogado@ipas.test
QA_ABOGADO_PASSWORD=CAMBIAR_LOCALMENTE

# Selenium
QA_BROWSER=edge
QA_HEADLESS=false
QA_WAIT_SECONDS=15

# Carga local moderada. Nunca apuntar a producción ni a servicios de IA.
QA_LOAD_USERS=5
QA_LOAD_SPAWN_RATE=1
QA_LOAD_DURATION_SECONDS=30
QA_LOAD_P95_LIMIT_MS=2000
QA_LOAD_ERROR_RATE_LIMIT=0.01

# Correo de reportes. Para proveedores reales usa contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# IA asistida. La clave nunca se guarda en docs/ia ni en reportes.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=60

# Alternativa conservada por compatibilidad con el alcance inicial.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2026-10-21
ANTHROPIC_TIMEOUT_SECONDS=60

